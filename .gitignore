# ── added 2026-09-28: evidence is not source ─────────────────────────
# eval/ and eval-before/ hold per-run artefacts from scripts/imp-eval.sh
# — the wish, the prompt, the 512x512 png sd-turbo painted, the braille
# and the frame. They are the record of what the imp did and they are
# genuinely useful, but they are OUTPUT, they are ~2MB per few runs, and
# a repository is not an art gallery. (covenant §5 says the filesystem
# never notices; a git history full of pngs would be the loudest possible
# contradiction, even if the *program* is the thing bound by the covenant.)
/eval/
/eval-before/

# .retired/ is kept on disk as the only undo — the tree is not a git
# repo, so history was the safety net. Now that it is one, the retired
# C bridge and the dead render/ask/imp sources are noise. They stay on
# disk; they just stop being versioned.
/.retired/
/.probes/

# build artifacts: the compiled one-shot and the toolchain droppings.
# rebuilt by ./build.sh console; never versioned.
/imp-console
/libRedRT-defs.r
/libRedRT-include.red
/libRedRT.so
/.console-build
/.console-build.red
