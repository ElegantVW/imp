Red [Title: "rite-soul"]
; RITE SOUL: the smallest vessel that must live. One function.
; If this cannot seal, nothing larger is worth trying.
t: to integer! #"漢"
; wide-cell: 2 columns
span: 2
; 666 arithmetic
beast: 6 * 111
; string + mold + write, the three sacred acts
sigil: rejoin [mold span " " mold beast]
write %rite-soul.txt sigil
