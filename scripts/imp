#!/usr/bin/env bash
# imp — the whole thing, which is a Red program.
#
#   imp                     opens the window (the TUI)
#   imp "a lighthouse"      one conjuring from the argument
#   imp < no tty            prompts for a wish, then one conjuring
#
# The PROGRAM is pure Red: src/conjure.red composes the request, calls
# sd-cli through `call/wait/shell`, decodes the png with Red's own codec,
# forges the glyphs, and publishes the frame. Not one line of the art path
# is C or Python, and the C bridge is gone.
#
# This file is the harness, not the program, and it is bash for the same
# reason rited is: the Red Console is a GUI, it gives you no stdout and
# no exit code, and something has to hold the tty while it thinks. The
# only thing done here that could be done in Red is WAITING, and Red has
# no `sleep`. That is the whole remaining C-shaped hole, and it is a
# launcher, not a dependency.
#
# Red cannot read a terminal — `stdin` and `termios` appear nowhere in the
# runtime source — so the window is the only door there is. That is not a
# compromise; it is the architecture.
set -uo pipefail

IMP="$HOME/imp"
RED="$IMP/red-view"
SHM="/dev/shm/imp"
SRC="$IMP/src/conjure.red"
TUI="$IMP/src/tui.red"
STAGED="$IMP/.cast-conjure.red"
STAGED_TUI="$IMP/.cast-tui.red"

SD="$HOME/.local/lib/sd/sd-cli"
SD_LIB="$HOME/.local/lib/sd"
SD_MODEL="$HOME/.local/share/pixie/models/sd_turbo-f16.gguf"
# 512, and the reason is a measurement rather than a preference. The
# hand is sd-turbo at 4 steps with cfg 1.0; at 256 it took 1.6s and at
# 512 it took 2.8s, while the picture went from "recognisable" to "a
# photograph" — branching lightning, textured cliffs, foam on the sea.
# The forge costs the same either way: the braille samples a fixed 80x48
# grid, so a 512 source means 6.4x6.4 source pixels per dot instead of
# 3.2x3.2, which is strictly more detail per cell and not more time.
# The old 560s-budget fear about 512 was measured at 20 steps and does
# not survive the corrected sampler.
SD_W=512
SD_H=512
# the sampler's own contract with sd-turbo. not tunables: these are the
# values the model was distilled for, and sd-cli's defaults are a
# different model's defaults. see the note at the call site in
# conjure.red, because until that fix the whole diagnosis of "sd-turbo is
# weak" was wrong.
SD_STEPS=4
SD_CFG=1
LLM=imp
LLM_URL="http://127.0.0.1:8082/v1/chat/completions"

die() { printf 'imp: %s\n' "$1" >&2; exit 1; }

# ── the door ────────────────────────────────────────────────────────
# bare imp, on a tty, with a display: the window. Red has no stdin, so
# there is no other way in.
WISH="${*:-}"
if [[ -z "$WISH" ]] && [[ -t 0 ]] && [[ -n "${DISPLAY:-}" ]]; then

  # the covenant, checked before anything runs — loopback only, and the
  # hand never listens at all: sd-cli is one-shot.
  case "$SD_MODEL" in /*) ;; *) die "the model path is not absolute" ;; esac
  [[ -x "$SD"  ]] || die "no hand at $SD (sd-cli)"
  [[ -f "$SD_MODEL" ]] || die "no weights at $SD_MODEL"

  mkdir -p "$SHM"
  # The mind is TOLD, it does not go and look. Red has no `getenv` —
  # measured: `mold :getenv` is `unset` — and calling a missing function
  # at the top level kills the rite before it can testify at all. So the
  # launcher writes down what it knows and the program reads it off disk.
  cat > "$SHM/imp-env.txt" <<ENV
sd=$SD
sd-lib=$SD_LIB
model=$SD_MODEL
w=$SD_W
h=$SD_H
steps=$SD_STEPS
cfg=$SD_CFG
llm=$LLM
llm-url=$LLM_URL
ENV

  # One console instance, and it must be dead before this one starts.
  pkill -x red-view 2>/dev/null
  sleep 0.3
  # THE TUI IS STAGED IN THE REPO ROOT AND RUN FROM THERE. Three things
  # here are load-bearing and none is documented:
  #
  #   * IT IS A SINGLE FILE. A wrapper that did `do %src/tui.red` and then
  #     `view win` loaded cleanly, built a valid face, and then showed
  #     NOTHING — `view` after a `do` does not open a window. Measured.
  #   * IT IS STAGED IN THE ROOT, because `do` resolves a relative path
  #     against the CWD, and `%src/core.red` only means something when the
  #     CWD is the root. Run from src/ it means src/src/core.red.
  #   * IT IS LAUNCHED FROM A SCRIPT THAT STAYS ALIVE. Launched inline —
  #     even via `bash -c` — the shell exits and red-view dies with it.
  #     The launcher is a script and polls, so it lives as long as the
  #     window does.
  # THE WRAPPER, not the program. src/tui.red is a LIBRARY: it builds `win`
  # and never views it, because a file that views itself is a file no rite
  # can load. Three things here are load-bearing and none is documented:
  #
  #   * THE WRAPPER NEEDS A `Red [...] NEEDS: View` HEADER. Without it the
  #     script dies on its first line, silently, and no window ever opens.
  #     Measured both ways.
  #   * IT IS STAGED IN THE ROOT, because `do` resolves a relative path
  #     against the CWD, and `%src/core.red` only means something when the
  #     CWD is the root. A wrapper in src/ doing `%src/tui.red` looks for
  #     src/src/tui.red.
  #   * IT IS LAUNCHED FROM A SCRIPT THAT STAYS ALIVE. Launched inline —
  #     even via `bash -c` — the shell exits and red-view dies with it.
  #     The launcher is a script and polls, so it lives as long as the
  #     window does.
  cat > "$STAGED_TUI" <<'WRAP'
Red [Title: "imp-tui" Needs: View]
do %src/tui.red
view win
WRAP
  ( cd "$IMP" && setsid env DISPLAY="${DISPLAY:-:0}" "$RED" ".cast-tui.red" \
      >/dev/null 2>&1 & )

  # The window is the product. Wait for it to close; there is no frame to
  # wait for and no log to read. The process going away is the only
  # signal, and it is the right one: the user closed the window.
  while pgrep -x red-view >/dev/null 2>&1; do
    sleep 0.5
  done
  rm -f "$STAGED_TUI"
  exit 0
fi

# ── the wish ────────────────────────────────────────────────────────
if [[ -z "$WISH" ]]; then
  printf '\033[38;5;175m⛓ imp\033[0m  what do you wish for? \033[38;5;60m^C to leave.\033[0m\n' >&2
  read -r -p '> ' WISH || die "the wish was never spoken."
  [[ -n "$WISH" ]] || die "an empty wish conjures nothing."
fi

# ── the covenant, checked before anything runs ──────────────────────
case "$SD_MODEL" in /*) ;; *) die "the model path is not absolute" ;; esac
[[ -x "$SD"  ]] || die "no hand at $SD (sd-cli)"
[[ -f "$SD_MODEL" ]] || die "no weights at $SD_MODEL"

mkdir -p "$SHM"
cat > "$SHM/imp-env.txt" <<ENV
sd=$SD
sd-lib=$SD_LIB
model=$SD_MODEL
w=$SD_W
h=$SD_H
steps=$SD_STEPS
cfg=$SD_CFG
llm=$LLM
llm-url=$LLM_URL
ENV
# the filesystem never notices: the job and the frame live in tmpfs
printf '%s' "$WISH" > "$SHM/job"
rm -f "$SHM/frame" "$SHM/frame.tmp" "$SHM/conjure.png" \
      "$SHM/imp-art.txt" "$SHM/conjure.log" \
      "$SHM/conjure-body.json" "$SHM/conjure-reply.json"

# ── cast the rite ───────────────────────────────────────────────────
pkill -x red-view 2>/dev/null
sleep 0.3
cp -f "$SRC" "$STAGED"
( cd "$IMP" && setsid env DISPLAY="${DISPLAY:-:0}" "$RED" ".cast-conjure.red" \
    >/dev/null 2>&1 & )

printf '\033[38;5;175m⛓ the imp is thinking\033[0m  \033[38;5;60m(sd-cli ~4s, then red forges)\033[0m\n' >&2

# ── wait on the FRAME, not on a log, and not on the process ─────────
# A log is a diary, not a bell. The frame is the rite's single end
# product, published by an atomic rename, so its existence means THIS
# run finished. Waiting on the log is how the C bridge used to kill the
# interpreter mid-paint. docs/GRIMOIRE.md hazard 21.
#
# And do NOT break early when red-view is absent from the process table.
# This loop used to do exactly that, and it is a race with our own
# startup: the interpreter is launched in a background subshell, so on
# the first poll — 0 ms later — it is not there yet, the launcher
# declared failure and exited, and the rite went on to paint a perfectly
# good 18 KB frame, orphaned, some 200 seconds later. Measured: exit 1,
# a complete frame on disk, and a log ending in DONE.
#
# The frame is the witness. The deadline is the only backstop.
deadline=$((SECONDS + 900))
while (( SECONDS < deadline )); do
  if [[ -s "$SHM/frame" ]]; then
    pkill -x red-view 2>/dev/null
    rm -f "$STAGED"
    cat "$SHM/frame"
    printf '\n'
    exit 0
  fi
  sleep 0.2
done

# ── it failed. say so, and say what it last said. ───────────────────
pkill -x red-view 2>/dev/null
rm -f "$STAGED"
printf 'imp: the vessel accepted the wish and painted nothing.\n' >&2
if [[ -s "$SHM/conjure.log" ]]; then
  printf 'imp: its last testimony:\n' >&2
  sed 's/^/    /' "$SHM/conjure.log" >&2
  printf '\n' >&2
fi
exit 1
